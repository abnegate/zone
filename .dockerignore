# Git
.git
.gitignore

# Node modules (will be installed in container)
**/node_modules

# Build outputs (will be built in container)
manager/frontend/build
packages/ui/dist

# Environment files
.env
.env.local
.env.*.local
**/.env.local
**/.env.*.local

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage
**/coverage

# Playwright
**/playwright-report
**/test-results

# Documentation (not needed in build)
*.md
!README.md

# Development configs
.editorconfig
.prettierrc
biome.json
**/biome.json

# Rust target (built in container)
runner/target
runner/**/target

# Stale offline query cache; the live one is runner/zone_server/.sqlx
runner/.sqlx

# Desktop bundle assets and generated platform projects; the manager image
# only needs zone_desktop's manifest and sources for the workspace to resolve
runner/zone_desktop/dist
runner/zone_desktop/gen
runner/zone_desktop/icons
runner/zone_desktop/capabilities
runner/zone_desktop/*.conf.json
