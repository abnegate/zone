  "query": "\n        UPDATE projects\n        SET name = COALESCE($2, name),\n            description = COALESCE($3, description),\n            status = COALESCE($4, status),\n            updated_at = NOW()\n        WHERE id = $1\n        RETURNING id, workspace_id, source_id, name, description, status,\n                  github_repo_url, github_access_token, created_at, updated_at\n        ",
