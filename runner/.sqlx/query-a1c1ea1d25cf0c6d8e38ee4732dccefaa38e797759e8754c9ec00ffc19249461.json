  "query": "\n        UPDATE invitations\n        SET accepted_at = NOW()\n        WHERE token_hash = $1\n          AND expires_at > NOW()\n          AND accepted_at IS NULL\n        RETURNING organization_id, workspace_ids, org_role, workspace_role\n        ",
