  "query": "\n        UPDATE task_runs\n        SET status = $2,\n            completed_at = NOW(),\n            error_message = $3,\n            artifacts = COALESCE($4, artifacts),\n            progress_percent = 100\n        WHERE id = $1\n        RETURNING id, task_id, status, current_phase, progress_percent, started_at,\n                  completed_at, error_message, artifacts\n        ",
