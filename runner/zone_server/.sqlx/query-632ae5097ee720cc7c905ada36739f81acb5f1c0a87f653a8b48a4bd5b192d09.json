  "query": "\n        UPDATE chats\n        SET title = COALESCE($2, title),\n            agent_enabled = COALESCE($3, agent_enabled),\n            updated_at = NOW()\n        WHERE id = $1\n        RETURNING id, workspace_id, title, model_name, archived, agent_enabled, created_at, updated_at\n        ",
