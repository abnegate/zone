  "query": "\n        SELECT id, email, organization_id, workspace_ids, org_role,\n               workspace_role, invited_by, expires_at, accepted_at, created_at\n        FROM invitations\n        WHERE email = $1\n          AND organization_id = $2\n          AND expires_at > NOW()\n          AND accepted_at IS NULL\n        ",
