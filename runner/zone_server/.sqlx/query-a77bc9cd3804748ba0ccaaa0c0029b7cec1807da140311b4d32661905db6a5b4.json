  "query": "\n        UPDATE synced_items\n        SET last_synced_at = NOW(),\n            last_external_state = COALESCE($2, last_external_state)\n        WHERE id = $1\n        RETURNING id, sync_config_id, task_id, external_id, external_url,\n                  last_synced_at, sync_direction, last_external_state, created_at\n        ",
