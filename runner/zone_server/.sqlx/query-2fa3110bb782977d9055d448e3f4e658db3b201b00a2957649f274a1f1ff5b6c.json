  "query": "\n        UPDATE workspaces\n        SET name = COALESCE($2, name),\n            description = COALESCE($3, description),\n            is_active = COALESCE($4, is_active),\n            updated_at = NOW()\n        WHERE id = $1\n        RETURNING id, organization_id, name, slug, description, is_active, created_at, updated_at\n        ",
