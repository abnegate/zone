{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zone",
  "version": "0.1.0",
  "identifier": "com.abnegate.zone",
  "mainBinaryName": "zone-desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Self-hosted AI platform",
    "longDescription": "Zone client: manager console on desktop, Android, and iOS.",
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libssl3"]
      }
    }
  }
}
