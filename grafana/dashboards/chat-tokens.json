      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(zone_chat_tokens_total[5m])) * 60",
          "refId": "A"
        }
      ],
      "title": "Tokens / min",
      "type": "stat",
      "description": "Only turns a provider gave a figure for. A backend that reports no usage contributes rounds and tool calls but no tokens, so compare this with zone_chat_turn_rounds_count before concluding a change made things cheaper."
    },
