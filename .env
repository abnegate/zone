# ---------- Domains (you said you'll handle DNS/port forward) ----------
WEBUI_HOST=webui.example.com
LITELLM_HOST=llm.example.com
SEARX_HOST=search.example.com

# ---------- Auth (Traefik BasicAuth) ----------
# Create the hash and put it into traefik/usersfile (instructions below)
BASICAUTH_REALM=AI Stack

# ---------- Models (Ollama model names) ----------
MODEL_FAST=llama3.1:8b
MODEL_REASONING=deepseek-r1:14b
MODEL_EMBEDDING=nomic-embed-text

# ---------- LiteLLM ----------
LITELLM_MASTER_KEY=change-me-super-long-random

# ---------- Open WebUI ----------
# We rely on Traefik auth, so we disable WebUI's own auth.
WEBUI_AUTH=false

# Use LiteLLM as the OpenAI-compatible backend for chat
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=${LITELLM_MASTER_KEY}

# Web Search (Open WebUI -> SearXNG)
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE=searxng
RAG_WEB_SEARCH_RESULT_COUNT=5
RAG_WEB_SEARCH_CONCURRENT_REQUESTS=8
SEARXNG_QUERY_URL=http://gluetun:8080/search?q=<query>

# Optional: make Open WebUI prefer env vars instead of DB-persisted config
ENABLE_PERSISTENT_CONFIG=false

# ---------- Gluetun (Surfshark) ----------
# See Gluetun docs for exact required variables for Surfshark.
VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=openvpn
OPENVPN_USER=your_surfshark_username
OPENVPN_PASSWORD=your_surfshark_password
TZ=Pacific/Auckland