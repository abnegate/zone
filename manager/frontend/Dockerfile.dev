# syntax=docker/dockerfile:1
# Development image: Vite HMR with the bun workspace layout preserved so
# @zone/ui resolves the same way it does on the host.
FROM oven/bun:1.4.0-alpine@sha256:07235578f79ef8c6f97d94aee7938e76f5cdba5f21ae5dbfdd3d3d38058437eb

WORKDIR /workspace

COPY --chown=bun:bun package.json bun.lock ./
COPY --chown=bun:bun packages/ui/package.json packages/ui/package.json
COPY --chown=bun:bun manager/frontend/package.json manager/frontend/package.json
RUN bun install --frozen-lockfile

# Seed sources so the image can boot without bind mounts. Compose overlays these.
COPY --chown=bun:bun packages/ui/src packages/ui/src
COPY --chown=bun:bun manager/frontend manager/frontend

WORKDIR /workspace/manager/frontend

ENV VITE_USE_POLLING=true
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=300

EXPOSE 3001

CMD ["bun", "run", "dev", "--host", "0.0.0.0", "--port", "3001"]
