{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"],
      "description": "Deployment environment"
    },
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "externalDatabase": {
          "type": "boolean"
        },
        "securityContexts": {
          "type": "boolean"
        }
      }
    },
    "commonEnv": {
      "type": "object",
      "required": ["DB_HOST", "DB_PORT", "DB_NAME"],
      "properties": {
        "DB_HOST": { "type": "string" },
        "DB_PORT": { "type": "string" },
        "DB_NAME": { "type": "string" },
        "DB_USER": { "type": "string" },
        "RUST_LOG": { "type": "string" },
        "LITELLM_HOST": { "type": "string" },
        "OLLAMA_HOST": { "type": "string" },
        "EMBEDDING_ENGINE": { "type": "string" },
        "VALKEY_HOST": { "type": "string" },
        "VALKEY_PORT": { "type": "string" },
        "REDIS_URL": { "type": "string" }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "dbPassword": { "type": "string" },
        "jwtSecret": { "type": "string" },
        "encryptionKey": { "type": "string" },
        "litellmMasterKey": { "type": "string" },
        "redisPassword": { "type": "string" },
        "redisUrl": {
          "type": "string",
          "pattern": "^(rediss?://.+)?$",
          "description": "redis:// or rediss:// URL written to the secret's valkey-url"
        },
        "stripeSecretKey": { "type": "string" },
        "smtpPassword": { "type": "string" },
        "keys": { "type": "object" }
      }
    },
    "highAvailability": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "externalValkey": {
          "type": "boolean",
          "description": "The existing secret's redisUrl key points at an external, managed Redis or Valkey"
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "annotations": { "type": "object" }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilization": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "strategy": { "type": "object" },
        "probes": {
          "type": "object",
          "properties": {
            "startup": {
              "allOf": [
                { "$ref": "#/definitions/probe" },
                { "properties": { "enabled": { "type": "boolean" } } }
              ]
            },
            "liveness": { "$ref": "#/definitions/probe" },
            "readiness": { "$ref": "#/definitions/probe" }
          }
        },
        "terminationGracePeriodSeconds": { "type": ["integer", "null"], "minimum": 0 },
        "baseUrl": { "type": "string" },
        "trustedProxies": { "type": "string" },
        "agentState": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "accessMode": {
                  "type": "string",
                  "enum": ["ReadWriteOnce", "ReadWriteMany"]
                },
                "size": { "type": "string" },
                "storageClass": { "type": "string" }
              }
            }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "manager": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "image": {
          "type": "object",
          "required": ["repository"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "podDisruptionBudget": { "$ref": "#/definitions/podDisruptionBudget" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespace": { "type": "string" },
        "externalDatabaseCIDR": { "type": "string" },
        "externalValkeyCIDR": { "type": "string" },
        "externalValkeyPort": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host", "paths"],
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "pathType", "service"],
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": {
                      "type": "string",
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    },
                    "service": {
                      "type": "string",
                      "enum": ["server", "manager"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": { "type": "array" }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "initialDelaySeconds": { "type": ["integer", "null"], "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    }
  }
}
