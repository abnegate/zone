# =============================================================================
# VOIZ - Self-Hosted AI Stack Configuration (Example)
# =============================================================================
# Copy this file to .env and fill in your actual values.
#
# Quick setup:
#   cp .env.example .env
#   ./scripts/setup.sh
#
# =============================================================================

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
# These hostnames must be configured in your DNS to point to this server.
# For local testing, add them to /etc/hosts pointing to 127.0.0.1
#
# Example:
#   127.0.0.1 webui.localhost api.localhost search.localhost

WEBUI_HOST=webui.localhost
LITELLM_HOST=api.localhost
API_HOST=api.localhost
SEARX_HOST=search.localhost

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# Basic Auth Realm (displayed in browser auth prompt)
BASICAUTH_REALM="Voiz AI Stack"

# Path to htpasswd file for basic authentication
# Generate with: htpasswd -nbB username password > auth/users.htpasswd
# Or use: make setup-auth
BASIC_AUTH_USERS_FILE=./auth/users.htpasswd

# -----------------------------------------------------------------------------
# API Keys & Secrets (REQUIRED - must change!)
# -----------------------------------------------------------------------------
# Generate secure random keys with: openssl rand -base64 32

# LiteLLM Master API Key (required)
# This key is used to authenticate to the LiteLLM API
LITELLM_MASTER_KEY=

# LiteLLM Salt Key (optional but recommended)
# Used for internal hashing and security
LITELLM_SALT_KEY=

# SearXNG Secret Key (required)
# Used for session encryption in SearXNG
SEARXNG_SECRET_KEY=

# -----------------------------------------------------------------------------
# Ollama Model Configuration
# -----------------------------------------------------------------------------
# Model names to pull from Ollama library: https://ollama.com/library
#
# Recommended combinations:
#   Small/Fast:     llama3.2:3b, qwen2.5:7b
#   Medium:         llama3.1:8b, mistral:7b
#   Large:          llama3.1:70b, mixtral:8x7b
#   Reasoning:      deepseek-r1:7b, deepseek-r1:14b, deepseek-r1:32b
#   Embeddings:     nomic-embed-text, mxbai-embed-large

# Fast model for general queries (4-8GB RAM)
OLLAMA_FAST_MODEL=llama3.1:8b

# Reasoning model for complex analysis (8-16GB RAM)
OLLAMA_REASON_MODEL=deepseek-r1:14b

# Embedding model for semantic search and routing (1-2GB RAM)
OLLAMA_EMBED_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Open WebUI Configuration
# -----------------------------------------------------------------------------
# Disable WebUI's built-in auth (we use Traefik basic auth instead)
# Set to true if you want to use Open WebUI's authentication
WEBUI_AUTH=false

# OpenAI API compatibility settings (internal service URLs)
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=${LITELLM_MASTER_KEY}

# Web Search Configuration (SearXNG integration)
ENABLE_RAG_WEB_SEARCH=true
RAG_WEB_SEARCH_ENGINE=searxng
RAG_WEB_SEARCH_RESULT_COUNT=5
RAG_WEB_SEARCH_CONCURRENT_REQUESTS=8

# SearXNG URL (via Gluetun VPN tunnel)
SEARXNG_QUERY_URL=http://gluetun:8080/search?q=<query>&format=json
SEARXNG_BASE_URL=http://gluetun:8080

# Application Settings
ENABLE_PERSISTENT_CONFIG=false
ENABLE_SIGNUP=false
DEFAULT_LOCALE=en-US

# -----------------------------------------------------------------------------
# VPN Configuration (Gluetun + Surfshark)
# -----------------------------------------------------------------------------
# VPN Provider
# See Gluetun docs for other providers: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=surfshark

# VPN Protocol (openvpn or wireguard)
VPN_TYPE=openvpn

# Surfshark Credentials (REQUIRED if using VPN)
# Get these from your Surfshark account settings
# For Surfshark, use your service username/password, NOT your login email
OPENVPN_USER=
OPENVPN_PASSWORD=

# Optional: Pin VPN server location
# Uncomment and set these to use specific servers
# SERVER_COUNTRIES=United States
# SERVER_CITIES=New York

# Timezone for containers (use your local timezone)
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# -----------------------------------------------------------------------------
# Advanced Configuration (optional)
# -----------------------------------------------------------------------------
# LiteLLM worker count (increase for better concurrency)
# Recommended: 1-2 per CPU core, max 8
LITELLM_WORKERS=4

# LiteLLM timeout settings (seconds)
LITELLM_REQUEST_TIMEOUT=600
LITELLM_ROUTER_TIMEOUT=120

# Ollama host binding (internal service URL)
OLLAMA_HOST=0.0.0.0:11434

# Email for Let's Encrypt ACME (required for automatic TLS)
# Only needed if you want automatic HTTPS certificates
ACME_EMAIL=admin@example.com
