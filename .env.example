# ZONE - Self-Hosted AI Stack Configuration
# ZERO CONFIGURATION REQUIRED! All variables have working defaults.
#
# Quick start (development):
#   cp .env.example .env
#   mkdir -p auth && htpasswd -cB auth/users.htpasswd admin
#   make up
#
# Production setup (with secure secrets):
#   ./scripts/setup.sh
#
# Variables are organized with prefixes for easy management:
#   DOMAIN_*         - Domain and hostname configuration
#   SECURITY_*       - Authentication and secrets
#   OLLAMA_*         - Model configuration
#   COMFYUI_*        - Image, video, and audio generation runtime
#   SEARCH_*         - Web search configuration
#   ZONE_MCP_*       - MCP servers for agent tools (magents, etc.)
#   VPN_*            - VPN and privacy settings
#   ZONE_VPN         - Full-tunnel overlay flag (synced with the vpn profile)
#   COMPOSE_PROFILES - Optional Compose profiles (dev,vpn,monitoring,...)
#   DOCKER_VERSION_* - Docker image versions
#   DOCKER_DIGEST_*  - Immutable multi-platform image digests
#   ADVANCED_*       - Performance and system settings

# DOMAIN_* - Domain Configuration
# Shared base domain for Manager and other service subdomains.
# The variable name is retained for existing installations.
DOMAIN_HOST_WEBUI=webui.localhost

# Browser origins allowed to call the Manager API with credentials.
# Comma separated; entries may be full origins or bare hosts. A host also
# covers its subdomains, so zone.example.com admits manager.zone.example.com
# but never evil-zone.attacker.com. DOMAIN_HOST_WEBUI is always included, and
# localhost, 127.0.0.1 and ::1 are always allowed for development. Left empty,
# the API answers loopback only.
CORS_ORIGINS=

# SECURITY_* - Security & Authentication
# CRITICAL: Change all keys before production deployment!
# Generate secure keys: openssl rand -base64 32
# Or use setup script: ./scripts/setup.sh

SECURITY_BASICAUTH_REALM="Zone AI Stack"
SECURITY_BASIC_AUTH_USERS_FILE=./auth/users.htpasswd
SECURITY_LITELLM_MASTER_KEY=
SECURITY_LITELLM_SALT_KEY=
SECURITY_SEARXNG_SECRET_KEY=
SECURITY_MANAGER_API_KEY=
SECURITY_LITELLM_UI_USERNAME=
SECURITY_LITELLM_UI_PASSWORD=
JWT_SECRET=
ENCRYPTION_KEY=

# PostgreSQL Database Credentials
# REQUIRED - No defaults! Generate secure values before starting.
# Quick start: ./scripts/setup.sh (auto-generates secure credentials)
# Manual: openssl rand -base64 32
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
# URL-encoded password for DATABASE_URL (set automatically by the setup script)
POSTGRES_PASSWORD_URLENCODED=

# HTTP to HTTPS redirect (false for local dev, true for production)
SECURITY_HTTP_REDIRECT=false

# Automatic TLS certificate generation via Let's Encrypt
# Requires: valid public domain, port 80/443 accessible, real email
SECURITY_GENERATE_CERTIFICATE=false

# OLLAMA_* - Model Configuration
# Browse models: https://ollama.com/library
#
# Recommended by hardware:
#   8GB RAM:  fast=llama3.2:3b, reason=deepseek-r1:7b
#   16GB RAM: fast=llama3.1:8b, reason=deepseek-r1:14b
#   32GB RAM: fast=llama3.1:8b, reason=deepseek-r1:32b

OLLAMA_MODEL_FAST=llama3.1:8b
OLLAMA_MODEL_REASON=deepseek-r1:32b
OLLAMA_MODEL_EMBED=nomic-embed-text
OLLAMA_MODEL_VISION=llava:7b
# Engine location. Default is the host daemon so Docker Desktop / Apple
# Silicon can use Metal (measured ~113 tok/s vs ~0.6 in the container on
# an M4 Max). Install Ollama and keep it listening on 11434.
# Bundled container (Linux NVIDIA passthrough or CPU-only):
#   OLLAMA_BASE_URL=http://ollama:11434
#   make up PROFILES=bundled-ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_MAX_LOADED_MODELS=3
# Filesystem path used for the Models page disk-usage meter (default: /)
# ZONE_DISK_PATH=/
# Where the manager computes embeddings for search/RAG.
#   ollama - call OLLAMA_MODEL_EMBED over HTTP (default)
#   local  - run OLLAMA_MODEL_EMBED in-process via ONNX Runtime (CPU); no
#            network hop and no contention with the chat model. Weights are
#            downloaded once into the manager_embed_cache volume.
#            Needs a zone-server built with the `local-embeddings` feature,
#            which is on by default.
EMBEDDING_ENGINE=ollama

# COMFYUI_* - Image, video, and audio generation
# Native Apple Silicon: keep ComfyUI on loopback. If Docker Desktop cannot
# reach it directly, use the authenticated bridge documented in docs/COMFYUI.md.
# Bundled NVIDIA: set COMFYUI_BASE_URL=http://comfyui:8188, run
# `make setup-comfyui-model` (and `make setup-comfyui-video-model` for Wan,
# `make setup-comfyui-audio-model` for ACE-Step, `make setup-comfyui-upscale-model`
# for upscaling), then `make up-comfyui`.
# COMFYUI_CHECKPOINT is the fallback image model when org/workspace AI settings
# do not set model_image. COMFYUI_VIDEO_UNET is the fallback video UNET when
# they do not set model_video, and COMFYUI_AUDIO_CHECKPOINT is the fallback
# audio checkpoint when they do not set model_audio.
# COMFYUI_UPSCALE_MODEL is the ESRGAN-family model chat upscaling runs, read
# from the ComfyUI models/upscale_models directory.
# COMFYUI_CLASSIFIER_MODEL is optional. Empty uses the chat/fast model that is
# actually installed. Org/workspace Fast overrides it when set.
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://host.docker.internal:8188
# Required only when using scripts/comfyui-loopback-bridge.py.
COMFYUI_API_TOKEN=
COMFYUI_WORKFLOW_PATH=/app/comfyui/workflows/flux1-schnell-fp8-api.json
COMFYUI_CHECKPOINT=flux1-schnell-fp8.safetensors
COMFYUI_VIDEO_WORKFLOW_PATH=/app/comfyui/workflows/wan2.2-ti2v-5b-api.json
COMFYUI_VIDEO_UNET=wan2.2_ti2v_5B_fp16.safetensors
COMFYUI_VIDEO_CLIP=umt5_xxl_fp8_e4m3fn_scaled.safetensors
COMFYUI_VIDEO_VAE=wan2.2_vae.safetensors
COMFYUI_AUDIO_WORKFLOW_PATH=/app/comfyui/workflows/ace-step-v1-3.5b-api.json
COMFYUI_AUDIO_CHECKPOINT=ace_step_v1_3.5b.safetensors
COMFYUI_UPSCALE_WORKFLOW_PATH=/app/comfyui/workflows/upscale-image-api.json
COMFYUI_UPSCALE_MODEL=RealESRGAN_x4plus.safetensors
COMFYUI_CLASSIFIER_MODEL=
COMFYUI_CLASSIFIER_TIMEOUT_SECS=3
COMFYUI_REQUEST_TIMEOUT_SECS=15
COMFYUI_GENERATION_TIMEOUT_SECS=300
COMFYUI_VIDEO_GENERATION_TIMEOUT_SECS=600
COMFYUI_AUDIO_GENERATION_TIMEOUT_SECS=600
COMFYUI_UPSCALE_GENERATION_TIMEOUT_SECS=600
COMFYUI_POLL_INTERVAL_MS=500
ARTIFACT_ROOT=/app/artifacts

# LoRA training from a submitted video.
# Frames are sampled above COMFYUI_TRAIN_FRAME_FPS so the sharpest frame of each
# moment wins its slot; repeats of a shot already kept are then dropped, which
# is why a clip can come back with fewer frames than its length times the rate.
# COMFYUI_TRAIN_FRAME_LIMIT caps what one clip contributes: the trainer's step
# ceiling means each extra frame past that is simply seen fewer times.
# ffmpeg and ffprobe ship in the manager image. Point these elsewhere only to
# use a build of your own; without them, images still train and videos are
# refused with a message saying why.
COMFYUI_FFMPEG=ffmpeg
COMFYUI_FFPROBE=ffprobe
COMFYUI_TRAIN_FRAME_FPS=4
COMFYUI_TRAIN_FRAME_LIMIT=48

# U2-Net weights that frame every training crop on its subject, so a dataset
# keeps what it is training on rather than whatever was in the middle of the
# shot. `make setup-vision-model` writes them into the shared models volume at
# vision/u2net.onnx (~168 MiB), which is where this looks when it is empty.
# Without them a photo is cropped on its centre and a video frame on whatever
# moved.
ZONE_VISION_MODEL=
# Megabytes one training upload may carry. Images and clips are posted inline
# as base64 and held in memory while the request is read, so this is a memory
# budget: raise it for long clips, lower it on a small host.
TRAIN_UPLOAD_LIMIT_MB=512

# SEARCH_* - Web Search Configuration
# Used by Zone (zone-server) chat.
# Queries go to SearXNG on the Gluetun network namespace (`gluetun:8080`).
# Note: Web search only works when the vpn profile is enabled
# Start with: make up-vpn  or  make up PROFILES=dev,vpn,monitoring

SEARCH_ENABLE_WEB_SEARCH=true
SEARCH_RESULT_COUNT=5
SEARCH_SEARXNG_QUERY_URL="http://gluetun:8080/search?q=<query>&format=json"
SEARCH_SEARXNG_SERVER_BASE_URL="http://localhost:8080"
SEARCH_SEARXNG_INSTANCE_NAME="Zone Search"

# Optional HTTP proxy for remote model catalog searches. `make up-vpn` sets
# this in .env to Gluetun's proxy; `make up` clears it for direct requests.
# VPN-attached Manager reaches that proxy at http://127.0.0.1:8888 (shared netns).
# GitHub REST origin. Override for GitHub Enterprise Server, e.g.
# https://github.example.com/api/v3 . Publication and pull-request sync both
# use it; unset means api.github.com.
GITHUB_API_URL=

MODEL_SEARCH_PROXY_URL=

# Optional HTTP proxy for proxy-aware tool commands and MCP subprocesses.
# Configured proxy failures do not fall back to direct requests.
# VPN-attached Manager uses http://127.0.0.1:8888 for the same reason.
TOOL_RUNNER_PROXY_URL=

# Written by `make up-vpn` (`1`) and cleared by `make up`. Kept in sync with
# the `vpn` Compose profile so internet-facing services share Gluetun's
# network namespace (full tunnel + kill switch).
ZONE_VPN=

# COMPOSE_PROFILES - Optional Compose profiles (comma-separated)
# Combine any of: dev, vpn, monitoring, bundled-ollama, bundled-comfyui
# Overlay files are selected automatically (`dev` → docker-compose.dev.yml,
# `vpn` → docker-compose.vpn.yml).
#   make up PROFILES=dev,vpn,monitoring
#   ./scripts/compose.sh --profile dev --profile vpn --profile monitoring up -d
# `make up` (no PROFILES) starts core services only and clears this value.
# scripts/compose.sh writes COMPOSE_FILE when overlays are needed and removes
# it for core-only launches (an empty value is invalid for Docker Compose).
COMPOSE_PROFILES=

# VPN_* - VPN Configuration (Optional)
# VPN is OPTIONAL - system works perfectly without it
# To enable: make up-vpn
# Direct Compose: ./scripts/compose.sh --profile vpn up -d
# Providers: https://github.com/qdm12/gluetun-wiki

VPN_SERVICE_PROVIDER=surfshark
VPN_TYPE=openvpn

# OpenVPN Configuration (use if VPN_TYPE=openvpn)
VPN_OPENVPN_USER=
VPN_OPENVPN_PASSWORD=

# WireGuard Configuration (use if VPN_TYPE=wireguard)
# Get these from your VPN provider's WireGuard configuration file
VPN_WIREGUARD_PRIVATE_KEY=
VPN_WIREGUARD_ADDRESSES=

# Optional: Server location (works for both OpenVPN and WireGuard)
# VPN_SERVER_COUNTRIES="United States"
# VPN_SERVER_CITIES=New York
# VPN_SERVER_REGIONS=California

# ZONE_MCP_* - MCP servers for agent tools (magents, etc.)
# Task execution and `zone run` attach stdio MCP servers as extra tools.
# If magents is on PATH, it is registered automatically (`magents mcp`).
# Config JSON matches Cursor: { "mcpServers": { "name": { "command", "args" } } }
# Children inherit the runner environment and per-server env overlay.
# When TOOL_RUNNER_PROXY_URL is set, its proxy policy takes precedence.
# Only configure executables you trust.
ZONE_MCP_ENABLED=true
ZONE_MCP_AUTO_MAGENTS=true
# ZONE_MCP_CONFIG=/path/to/mcp.json
# ZONE_MCP_SERVERS={"mcpServers":{"magents":{"command":"magents","args":["mcp"]}}}

# ZONE_AGENT_ENV_PASSTHROUGH - Extra variables chat and task tools may read.
# Comma separated names. Tools otherwise see only PATH, HOME, USER, SHELL,
# LANG, LC_*, TERM, TZ, TMPDIR, XDG_RUNTIME_DIR and the proxy variables, so
# the database URL, JWT secret and API keys never reach a shell or a
# transcript. Name only variables you are willing to see in tool output.
# ZONE_AGENT_ENV_PASSTHROUGH=CARGO_HOME,RUSTUP_HOME

# MONITORING_* - Prometheus & Grafana Configuration (Optional)
# Enable monitoring: make up PROFILES=monitoring
# Access Grafana at: http://grafana.${DOMAIN_HOST_WEBUI}
# Access Prometheus at: http://prometheus.${DOMAIN_HOST_WEBUI}

# Set to true if you want to use monitoring (reminder only - use --profile monitoring)
MONITORING_ENABLED=false
MONITORING_PROMETHEUS_URL=http://prometheus:9090
MONITORING_GRAFANA_URL=http://grafana:3000
MONITORING_GRAFANA_ADMIN_USER=admin
# Applied to the Grafana admin user on every container start (not only first boot).
MONITORING_GRAFANA_ADMIN_PASSWORD=
MONITORING_GRAFANA_TOKEN=
MONITORING_RETENTION_TIME=15d

# Alerting Configuration (Optional)
# Configure email alerts for critical system events
ALERT_ENABLED=false
ALERT_EMAIL_RECIPIENTS=admin@example.com
# Discord: Channel → Edit → Integrations → Webhooks → New Webhook.
# Phone push is Discord's own notification for that channel. No SMTP needed.
ALERT_DISCORD_WEBHOOK_URL=

# SMTP Configuration for Grafana alerts
# Common providers:
#   Gmail: smtp.gmail.com:587 (requires app password)
#   AWS SES: email-smtp.<region>.amazonaws.com:587
#   SendGrid: smtp.sendgrid.net:587
#   Mailgun: smtp.mailgun.org:587
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM_ADDRESS=alerts@example.com
ALERT_SMTP_FROM_NAME="Zone Alerts"

