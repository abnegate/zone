COMFYUI_COMMIT=30bdda1ef13a3a34fce2cd2fec633f15d832122a

# ADVANCED_* - Advanced Configuration
ADVANCED_LITELLM_WORKERS=4
ADVANCED_LITELLM_REQUEST_TIMEOUT=600
ADVANCED_LITELLM_ROUTER_TIMEOUT=120
ADVANCED_TZ=UTC
ADVANCED_ACME_EMAIL=admin@example.com
