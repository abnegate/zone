{
  "name": "zone",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "manager/frontend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:manager": "bun run --filter zone dev",
    "start:manager": "bun run --filter zone start",
    "build": "bun run --filter '*' build",
    "build:ui": "bun run --filter @zone/ui build",
    "watch:ui": "bun run --filter @zone/ui watch",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "lint": "bun run --filter '*' lint",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test:coverage",
    "test:e2e": "bun run --filter '*' test:e2e",
    "test:e2e:ui": "bun run --filter '*' test:e2e:ui",
    "lighthouse": "bun run --filter '*' lighthouse",
    "audit": "bun run --filter '*' audit",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run test:e2e"
  },
  "devDependencies": {
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-systemjs": "7.29.8",
    "@isaacs/brace-expansion": "5.0.1",
    "ajv": "8.20.0",
    "basic-ftp": "6.2.1",
    "body-parser": "1.20.6",
    "brace-expansion": "5.0.9",
    "browserslist": "4.28.8",
    "dompurify": "3.4.14",
    "fast-uri": "3.1.7",
    "ip-address": "10.7.0",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "path-to-regexp": "0.1.13",
    "picomatch": "4.0.7",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "rollup": "4.63.1",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  }
}
