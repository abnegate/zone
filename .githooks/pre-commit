#!/bin/bash
# Pre-commit hook for zone repository
# Runs formatters on staged files before committing (in parallel)

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Track background jobs and their results
RUST_PID=""
FRONTEND_PID=""
RUST_RESULT_FILE=$(mktemp)
FRONTEND_RESULT_FILE=$(mktemp)

# Cleanup temp files on exit
cleanup() {
    rm -f "$RUST_RESULT_FILE" "$FRONTEND_RESULT_FILE"
}
trap cleanup EXIT

# Check if we have staged Rust files
STAGED_RUST_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

# Check if we have staged frontend files
STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^manager/frontend/src/.*\.(ts|tsx|js|jsx)$' || true)

# Run Rust check in background
if [ -n "$STAGED_RUST_FILES" ]; then
    (
        echo -e "${YELLOW}Checking Rust formatting...${NC}"

        if command -v cargo &> /dev/null; then
            cd runner
            if cargo fmt --check 2>/dev/null; then
                echo "0" > "$RUST_RESULT_FILE"
                echo -e "${GREEN}Rust formatting check passed!${NC}"
            else
                echo "1" > "$RUST_RESULT_FILE"
                echo -e "${RED}Rust formatting check failed!${NC}"
                echo -e "${YELLOW}Run 'cd runner && cargo fmt' to fix formatting${NC}"
            fi
        else
            echo "0" > "$RUST_RESULT_FILE"
            echo -e "${YELLOW}Warning: cargo not found, skipping Rust format check${NC}"
        fi
    ) &
    RUST_PID=$!
else
    echo "0" > "$RUST_RESULT_FILE"
fi

# Run Frontend check in background
if [ -n "$STAGED_FRONTEND_FILES" ]; then
    (
        echo -e "${YELLOW}Checking frontend with Biome...${NC}"

        if [ -f "manager/frontend/node_modules/.bin/biome" ]; then
            cd manager/frontend
            if npx biome check src 2>/dev/null; then
                echo "0" > "$FRONTEND_RESULT_FILE"
                echo -e "${GREEN}Biome check passed!${NC}"
            else
                echo "1" > "$FRONTEND_RESULT_FILE"
                echo -e "${RED}Biome check failed!${NC}"
                echo -e "${YELLOW}Run 'cd manager/frontend && npm run check:fix' to fix issues${NC}"
            fi
        elif command -v biome &> /dev/null; then
            cd manager/frontend
            if biome check src 2>/dev/null; then
                echo "0" > "$FRONTEND_RESULT_FILE"
                echo -e "${GREEN}Biome check passed!${NC}"
            else
                echo "1" > "$FRONTEND_RESULT_FILE"
                echo -e "${RED}Biome check failed!${NC}"
                echo -e "${YELLOW}Run 'cd manager/frontend && biome check --write src' to fix issues${NC}"
            fi
        else
            echo "0" > "$FRONTEND_RESULT_FILE"
            echo -e "${YELLOW}Warning: Biome not installed, skipping frontend checks${NC}"
            echo -e "${YELLOW}Run 'cd manager/frontend && npm install' to install${NC}"
        fi
    ) &
    FRONTEND_PID=$!
else
    echo "0" > "$FRONTEND_RESULT_FILE"
fi

# Wait for background jobs to complete
FAILED=0

if [ -n "$RUST_PID" ]; then
    wait $RUST_PID || true
fi

if [ -n "$FRONTEND_PID" ]; then
    wait $FRONTEND_PID || true
fi

# Check results
RUST_RESULT=$(cat "$RUST_RESULT_FILE" 2>/dev/null || echo "0")
FRONTEND_RESULT=$(cat "$FRONTEND_RESULT_FILE" 2>/dev/null || echo "0")

if [ "$RUST_RESULT" != "0" ] || [ "$FRONTEND_RESULT" != "0" ]; then
    echo -e "${RED}Pre-commit checks failed!${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
