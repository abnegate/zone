#!/bin/bash
# Pre-commit hook for voiz repository
# Runs formatters on staged files before committing (in parallel)

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Track background jobs and their results
GLEAM_PID=""
FRONTEND_PID=""
GLEAM_RESULT_FILE=$(mktemp)
FRONTEND_RESULT_FILE=$(mktemp)

# Cleanup temp files on exit
cleanup() {
    rm -f "$GLEAM_RESULT_FILE" "$FRONTEND_RESULT_FILE"
}
trap cleanup EXIT

# Check if we have staged Gleam files
STAGED_GLEAM_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.gleam$' || true)

# Check if we have staged frontend files
STAGED_FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^manager/frontend/src/.*\.(ts|tsx|js|jsx)$' || true)

# Run Gleam check in background
if [ -n "$STAGED_GLEAM_FILES" ]; then
    (
        echo -e "${YELLOW}Checking Gleam formatting...${NC}"

        if command -v gleam &> /dev/null; then
            cd manager
            if gleam format --check src test 2>/dev/null; then
                echo "0" > "$GLEAM_RESULT_FILE"
                echo -e "${GREEN}Gleam formatting check passed!${NC}"
            else
                echo "1" > "$GLEAM_RESULT_FILE"
                echo -e "${RED}Gleam formatting check failed!${NC}"
                echo -e "${YELLOW}Run 'cd manager && gleam format src test' to fix formatting${NC}"
            fi
        elif command -v docker &> /dev/null; then
            if docker run --rm -v "$(pwd)/manager:/app" -w /app ghcr.io/gleam-lang/gleam:v1.14.0-erlang gleam format --check src test 2>/dev/null; then
                echo "0" > "$GLEAM_RESULT_FILE"
                echo -e "${GREEN}Gleam formatting check passed!${NC}"
            else
                echo "1" > "$GLEAM_RESULT_FILE"
                echo -e "${RED}Gleam formatting check failed!${NC}"
                echo -e "${YELLOW}Run: docker run --rm -v \"\$(pwd)/manager:/app\" -w /app ghcr.io/gleam-lang/gleam:v1.14.0-erlang gleam format src test${NC}"
            fi
        else
            echo "0" > "$GLEAM_RESULT_FILE"
            echo -e "${YELLOW}Warning: Neither gleam nor docker found, skipping Gleam format check${NC}"
        fi
    ) &
    GLEAM_PID=$!
else
    echo "0" > "$GLEAM_RESULT_FILE"
fi

# Run Frontend check in background
if [ -n "$STAGED_FRONTEND_FILES" ]; then
    (
        echo -e "${YELLOW}Checking frontend with Biome...${NC}"

        if [ -f "manager/frontend/node_modules/.bin/biome" ]; then
            cd manager/frontend
            if npx biome check src 2>/dev/null; then
                echo "0" > "$FRONTEND_RESULT_FILE"
                echo -e "${GREEN}Biome check passed!${NC}"
            else
                echo "1" > "$FRONTEND_RESULT_FILE"
                echo -e "${RED}Biome check failed!${NC}"
                echo -e "${YELLOW}Run 'cd manager/frontend && npm run check:fix' to fix issues${NC}"
            fi
        elif command -v biome &> /dev/null; then
            cd manager/frontend
            if biome check src 2>/dev/null; then
                echo "0" > "$FRONTEND_RESULT_FILE"
                echo -e "${GREEN}Biome check passed!${NC}"
            else
                echo "1" > "$FRONTEND_RESULT_FILE"
                echo -e "${RED}Biome check failed!${NC}"
                echo -e "${YELLOW}Run 'cd manager/frontend && biome check --write src' to fix issues${NC}"
            fi
        else
            echo "0" > "$FRONTEND_RESULT_FILE"
            echo -e "${YELLOW}Warning: Biome not installed, skipping frontend checks${NC}"
            echo -e "${YELLOW}Run 'cd manager/frontend && npm install' to install${NC}"
        fi
    ) &
    FRONTEND_PID=$!
else
    echo "0" > "$FRONTEND_RESULT_FILE"
fi

# Wait for background jobs to complete
FAILED=0

if [ -n "$GLEAM_PID" ]; then
    wait $GLEAM_PID || true
fi

if [ -n "$FRONTEND_PID" ]; then
    wait $FRONTEND_PID || true
fi

# Check results
GLEAM_RESULT=$(cat "$GLEAM_RESULT_FILE" 2>/dev/null || echo "0")
FRONTEND_RESULT=$(cat "$FRONTEND_RESULT_FILE" 2>/dev/null || echo "0")

if [ "$GLEAM_RESULT" != "0" ] || [ "$FRONTEND_RESULT" != "0" ]; then
    echo -e "${RED}Pre-commit checks failed!${NC}"
    exit 1
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
