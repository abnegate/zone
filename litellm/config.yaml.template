# LiteLLM Proxy Configuration
# Documentation: https://docs.litellm.ai/docs/

model_list:
  - model_name: fast
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_FAST}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 60

  - model_name: "{{OLLAMA_MODEL_FAST}}"
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_FAST}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 60

  - model_name: reason
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_REASON}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 180

  - model_name: "{{OLLAMA_MODEL_REASON}}"
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_REASON}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 180

  # Embedding Model - For RAG and semantic search
  - model_name: "{{OLLAMA_MODEL_EMBED}}"
    litellm_params:
      model: ollama/{{OLLAMA_MODEL_EMBED}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 30

  - model_name: vision
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_VISION}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 180

  - model_name: "{{OLLAMA_MODEL_VISION}}"
    litellm_params:
      model: ollama_chat/{{OLLAMA_MODEL_VISION}}
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 180

  # Route models selected in the browser while preserving explicit aliases.
  - model_name: "*"
    litellm_params:
      model: ollama_chat/*
      api_base: {{OLLAMA_BASE_URL}}
      timeout: 180

# Router Configuration
router_settings:
  num_retries: 2
  timeout: 180
  fallbacks:
    - fast: ["reason", "{{OLLAMA_MODEL_REASON}}"]
    - "{{OLLAMA_MODEL_FAST}}": ["{{OLLAMA_MODEL_REASON}}"]

# General Settings
general_settings:
  # Master key for API authentication (set via LITELLM_MASTER_KEY env var)
  master_key: os.environ/LITELLM_MASTER_KEY

  # Default model when not specified
  default_model: "{{OLLAMA_MODEL_FAST}}"

  # Privacy-first configuration: Do NOT log prompts or completions
  # This prevents sensitive user data from being stored in the database
  store_model_in_db: true
  store_prompts_in_spend_logs: false

# LiteLLM Settings
litellm_settings:
  drop_params: false
  # Anthropic tool turns without thinking_blocks drop thinking instead of 400.
  modify_params: true
  set_verbose: false

  # Add routing info to response headers
  return_response_headers: true

  # Enable Prometheus metrics
  success_callback: ["prometheus"]
  failure_callback: ["prometheus"]
