# =============================================================================
# Zone Development Tiltfile
# =============================================================================
# Usage:
#   make tilt-up                     # Generate secrets and start Tilt
#   tilt up -- --only=infra          # Start a subset of resources
#   tilt down                        # Stop Tilt-managed resources
# =============================================================================

load('ext://namespace', 'namespace_create')

k8s_kind('Cluster', image_json_path='{.spec.imageName}')

config.define_string_list("only", args=True)
cfg = config.parse()
only = cfg.get("only", [])

def should_run(name):
    if not only:
        return True
    return name in only or any(name.startswith(prefix) for prefix in only)

namespace_create('zone')

k8s_yaml('secrets.yaml')
k8s_resource('zone-secrets', labels=['infrastructure'])
k8s_resource('zone-postgres-superuser', labels=['infrastructure'])

# =============================================================================
# Infrastructure (zone-infra chart)
# =============================================================================
if should_run("infra"):
    k8s_yaml(helm(
        '../helm/zone-infra',
        name='zone-infra',
        namespace='zone',
        values=['../helm/zone-infra/values.yaml', 'values-tilt-infra.yaml'],
        set=['global.namespace=zone'],
    ))
    k8s_resource(
        new_name='postgres',
        objects=['zone-postgres:Cluster'],
        extra_pod_selectors=[{'cnpg.io/cluster': 'zone-postgres'}],
        port_forwards=['5432:5432'],
        labels=['infrastructure'],
        resource_deps=['zone-secrets', 'zone-postgres-superuser'],
    )
    k8s_resource(
        'valkey',
        port_forwards=['6379:6379'],
        labels=['infrastructure'],
        resource_deps=['zone-secrets'],
    )

# =============================================================================
# AI Services (zone-ai chart)
# =============================================================================
if should_run("ai"):
    k8s_yaml(helm(
        '../helm/zone-ai',
        name='zone-ai',
        namespace='zone',
        values=['../helm/zone-ai/values.yaml', 'values-tilt-ai.yaml'],
        set=['global.namespace=zone'],
    ))
    k8s_resource(
        'ollama',
        port_forwards=['11434:11434'],
        labels=['ai'],
    )
    k8s_resource(
        'litellm',
        port_forwards=['4000:4000'],
        labels=['ai'],
        resource_deps=['ollama', 'postgres'],
    )

# =============================================================================
# Application Services
# =============================================================================
if should_run("manager") or should_run("apps"):
    docker_build(
        'zone/server',
        context='..',
        dockerfile='../manager/Dockerfile',
    )

if should_run("console"):
    local_resource(
        'console-dev',
        serve_cmd='cd ../manager/frontend && bun run dev',
        serve_dir='../manager/frontend',
        deps=['../manager/frontend/src', '../manager/frontend/package.json'],
        labels=['apps'],
        links=[
            link('http://localhost:3001', 'Console (dev)'),
        ],
    )

if should_run("apps"):
    k8s_yaml(helm(
        '../helm/zone-apps',
        name='zone-apps',
        namespace='zone',
        values=['../helm/zone-apps/values.yaml', 'values-tilt-apps.yaml'],
        set=['global.namespace=zone'],
    ))
    k8s_resource(
        'zone-apps-server',
        new_name='server',
        port_forwards=['8000:8000'],
        labels=['apps'],
        resource_deps=['postgres', 'valkey', 'litellm'],
    )
    k8s_resource(
        'openwebui',
        port_forwards=['8080:8080'],
        labels=['apps'],
        resource_deps=['litellm'],
        links=[
            link('http://localhost:8080', 'Open WebUI'),
        ],
    )

update_settings(
    max_parallel_updates=3,
    k8s_upsert_timeout_secs=180,
)

if config.tilt_subcommand == 'up':
    print('')
    print('=' * 60)
    print('Zone Development Environment')
    print('=' * 60)
    print('')
    print('Services:')
    print('  Console (dev):    http://localhost:3001')
    print('  Server API:       http://localhost:8000')
    print('  Open WebUI:       http://localhost:8080')
    print('  LiteLLM:          http://localhost:4000')
    print('  Ollama:           http://localhost:11434')
    print('')
    print('Tilt UI:            http://localhost:10350')
    print('')
    print('Pull a model into the cluster Ollama with:')
    print('  kubectl -n zone exec deploy/ollama -- ollama pull nomic-embed-text')
    print('=' * 60)
