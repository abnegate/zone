# =============================================================================
# Zone Development Tiltfile
# =============================================================================
# Usage:
#   tilt up                          # Start all services
#   tilt up -- --only=manager        # Start specific resources
#   tilt down                        # Stop all services
# =============================================================================

load('ext://helm_resource', 'helm_resource', 'helm_repo')
load('ext://namespace', 'namespace_create')

# Configuration
config.define_string_list("only", args=True)
cfg = config.parse()
only = cfg.get("only", [])

def should_run(name):
    """Check if a resource should run based on --only filter"""
    if not only:
        return True
    return name in only or any(name.startswith(prefix) for prefix in only)

# =============================================================================
# Namespace
# =============================================================================
namespace_create('zone')

# =============================================================================
# Secrets (generated by tilt-up.sh, applied first)
# =============================================================================
k8s_yaml('secrets.yaml')
k8s_resource(
    'zone-secrets',
    labels=['infrastructure'],
)

# =============================================================================
# Infrastructure (zone-infra chart)
# =============================================================================
if should_run("infra"):
    helm_resource(
        'zone-infra',
        '../helm/zone-infra',
        namespace='zone',
        flags=[
            '--set=global.namespace=zone',
        ],
        labels=['infrastructure'],
        resource_deps=['zone-secrets'],
    )

# =============================================================================
# AI Services (zone-ai chart)
# =============================================================================
if should_run("ai"):
    helm_resource(
        'zone-ai',
        '../helm/zone-ai',
        namespace='zone',
        flags=[
            '--set=global.namespace=zone',
        ],
        labels=['ai'],
        resource_deps=['zone-infra'],
    )

# =============================================================================
# Application Services
# =============================================================================

# Manager (Rust backend) - custom Docker build
# Note: The image is named 'zone/server' because it's the server component,
# even though the Dockerfile is in the manager directory (monorepo structure)
if should_run("manager"):
    docker_build(
        'zone/server',
        context='..',
        dockerfile='../manager/Dockerfile',
    )

# Console (React frontend) - run locally with Vite for HMR
if should_run("console"):
    local_resource(
        'console-dev',
        serve_cmd='cd ../manager/frontend && bun run dev -- --port 3000',
        serve_dir='../manager/frontend',
        deps=['../manager/frontend/src', '../manager/frontend/package.json'],
        labels=['apps'],
        links=[
            link('http://localhost:3000', 'Console (dev)'),
        ],
    )

# Apps chart (server, manager, openwebui)
if should_run("apps"):
    helm_resource(
        'zone-apps',
        '../helm/zone-apps',
        namespace='zone',
        flags=[
            '--set=global.namespace=zone',
            '--set=environment=development',
            '--set=server.image.repository=zone/server',
            '--set=server.image.tag=dev',
            '--set=server.image.pullPolicy=Never',
            '--set=server.replicaCount=1',
            '--set=server.autoscaling.enabled=false',
            '--set=manager.enabled=false',  # Using local dev server instead
            '--set=migration.enabled=false',
            '--set=ingress.enabled=false',
        ],
        image_deps=['zone/server'],
        image_keys=[('server.image.repository', 'server.image.tag')],
        labels=['apps'],
        resource_deps=['zone-ai'],
    )

# =============================================================================
# Port Forwards
# =============================================================================

# Forward ports for easy local access
# Note: CNPG creates pods with pattern zone-postgres-{N} (e.g., zone-postgres-1)
k8s_resource(
    workload='zone-postgres-1',
    new_name='postgres',
    port_forwards=['5432:5432'],
    labels=['infrastructure'],
    resource_deps=['zone-infra'],
)

k8s_resource(
    workload='valkey',
    port_forwards=['6379:6379'],
    labels=['infrastructure'],
    resource_deps=['zone-infra'],
)

k8s_resource(
    workload='ollama',
    port_forwards=['11434:11434'],
    labels=['ai'],
    resource_deps=['zone-ai'],
)

k8s_resource(
    workload='litellm',
    port_forwards=['4000:4000'],
    labels=['ai'],
    resource_deps=['zone-ai'],
)

k8s_resource(
    workload='zone-apps-server',
    new_name='server',
    port_forwards=['8000:8080'],
    labels=['apps'],
    resource_deps=['zone-apps'],
)

k8s_resource(
    workload='openwebui',
    port_forwards=['8080:8080'],
    labels=['apps'],
    resource_deps=['zone-apps'],
    links=[
        link('http://localhost:8080', 'Open WebUI'),
    ],
)

# =============================================================================
# Tilt Settings
# =============================================================================

update_settings(
    max_parallel_updates=3,
    k8s_upsert_timeout_secs=180,
)

# Useful links in the Tilt UI
if config.tilt_subcommand == 'up':
    print('')
    print('=' * 60)
    print('Zone Development Environment')
    print('=' * 60)
    print('')
    print('Services:')
    print('  Console (dev):    http://localhost:3000')
    print('  Server API:       http://localhost:8000')
    print('  Open WebUI:       http://localhost:8080')
    print('  LiteLLM:          http://localhost:4000')
    print('  Ollama:           http://localhost:11434')
    print('')
    print('Tilt UI:            http://localhost:10350')
    print('')
    print('=' * 60)
