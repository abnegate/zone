{
  "ci": {
    "collect": {
      "staticDistDir": "./build",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": ["--no-sandbox"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", {"minScore": 1}],
        "categories:best-practices": ["error", {"minScore": 0.96}],
        "categories:seo": ["error", {"minScore": 1}],
        "errors-in-console": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
